{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rodrigorosadantas.github.io/central-estudos/config/status-contract.schema.json",
  "title": "Central de Estudos — Status Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "publishedAt",
    "source",
    "state"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "publishedAt": {
      "type": "string",
      "format": "date"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "status",
        "updatedAt"
      ],
      "properties": {
        "kind": {
          "const": "public-project-state"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "cycle",
        "currentUnit",
        "nextAction",
        "nextActionKind",
        "alerts"
      ],
      "properties": {
        "phase": {
          "type": [
            "string",
            "null"
          ]
        },
        "cycle": {
          "type": [
            "string",
            "null"
          ]
        },
        "currentUnit": {
          "type": [
            "string",
            "null"
          ]
        },
        "nextAction": {
          "type": [
            "string",
            "null"
          ]
        },
        "nextActionKind": {
          "enum": [
            "operational",
            "planned",
            "manual",
            "none"
          ]
        },
        "alerts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 10
        }
      }
    },
    "study": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence",
        "sourceRef",
        "updatedAt",
        "trail",
        "lastCompletedUnit",
        "nextUnit",
        "lastStudiedAt",
        "questionsDone",
        "correct",
        "errors",
        "doubts",
        "accuracy",
        "reviewsDue",
        "nextReviewAt",
        "activeErrors",
        "completedSessions",
        "totalSessions",
        "notes"
      ],
      "properties": {
        "evidence": {
          "enum": [
            "confirmed",
            "partial",
            "planned",
            "unavailable"
          ]
        },
        "sourceRef": {
          "type": "string",
          "minLength": 1
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "trail": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastCompletedUnit": {
          "type": [
            "string",
            "null"
          ]
        },
        "nextUnit": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastStudiedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "questionsDone": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "correct": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "errors": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "doubts": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "accuracy": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "reviewsDue": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "nextReviewAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "activeErrors": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "completedSessions": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "totalSessions": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 8
        },
        "timeCredits": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "date",
              "kind",
              "unit",
              "trail",
              "minutes",
              "sourceRef"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "date": {
                "type": "string",
                "format": "date"
              },
              "kind": {
                "enum": [
                  "reading",
                  "study"
                ]
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "trail": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "minutes": {
                "const": 60
              },
              "sourceRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            }
          }
        }
      }
    }
  }
}
